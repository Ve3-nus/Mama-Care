<?xml version="1.0" encoding="utf-8"?>
<!--
    Emergency SOS screen: a large button the user taps to call for help.
    The button's click logic (ACTION_DIAL) is implemented by Ryan in SosFragment.
    Button ID: btnSos
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSosTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sos_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSosInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/sos_instruction"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSos"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="40dp"
            android:contentDescription="@string/sos_button_description"
            android:text="@string/sos_button"
            android:textColor="?attr/colorOnError"
            android:textSize="40sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorError"
            app:cornerRadius="100dp" />

        <TextView
            android:id="@+id/tvSosNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/sos_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</layout>